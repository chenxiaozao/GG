# This is a public template. bash manage.sh init creates a private .env without overwriting it.
# A real DNS hostname, without https:// or /api. Point its A record to the server first.
API_DOMAIN=
ACME_EMAIL=
ALLOWED_ORIGINS=https://chenxiaozao.github.io
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: add a NEW private DeepSeek key on the server; never use VITE_* for keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100
